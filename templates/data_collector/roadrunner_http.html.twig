{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% if collector.active %}
        {% set icon %}
            {{ include('@RoadRunnerHttp/data_collector/assets/roadrunner.svg') }}
            <span class="sf-toolbar-value">{{ collector.entries|length }}</span>
        {% endset %}
        {% set text %}
            <div class="sf-toolbar-info-piece">
                <b>RoadRunner HTTP middleware calls</b>
                <span>{{ collector.entries|length }}</span>
            </div>
        {% endset %}
        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: true}) }}
    {% endif %}
{% endblock %}

{% block menu %}
    {% if collector.active %}
        <span class="label">
            <span class="icon">{{ include('@RoadRunnerHttp/data_collector/assets/roadrunner.svg') }}</span>
            <strong>RoadRunner HTTP</strong>
        </span>
    {% endif %}
{% endblock %}

{% block panel %}
    <h2>RoadRunner HTTP middleware</h2>
    {% if collector.active and collector.entries %}
        <table>
            <thead>
                <tr>
                    <th scope="col">Service ID</th>
                    <th scope="col">Scope</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in collector.entries %}
                    <tr>
                        <td>{{ entry.id }}</td>
                        <td>{{ entry.scope }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="empty">
            <p>
                {{ collector.active
                    ? 'No middleware ran for this request.'
                    : 'This profile has no RoadRunner HTTP worker request.' }}
            </p>
        </div>
    {% endif %}
{% endblock %}
